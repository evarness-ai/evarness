{
  "ir_version": 1,
  "id": "governed-email-assistant",
  "name": "Governed Email Assistant",
  "description": "Flagship pattern: deterministic intent routing + interceptors + tool + retrieval + short-term memory + budget-aware context assembly. Agent = Harness + Model.",
  "nodes": [
    {"id": "n1", "type": "input", "label": "Input", "config": {"schema": "user_question"}, "position": {"x": 20, "y": 60}},
    {"id": "n2", "type": "intent_router", "label": "Intent Router",
     "config": {"rules": [{"route": "email_query", "keywords": ["email", "vacation", "meeting", "inbox", "pto", "days"]}],
                "fallback": "reject"},
     "position": {"x": 200, "y": 60}},
    {"id": "n3", "type": "interceptor", "label": "Interceptor (pre)",
     "config": {"chain": ["pii_scrub", "policy_check"]}, "position": {"x": 380, "y": 60}},
    {"id": "n4", "type": "tool", "label": "Email (mock)",
     "config": {"tool": "email.search"}, "position": {"x": 560, "y": 60}},
    {"id": "n5", "type": "retriever", "label": "Retriever",
     "config": {"top_k": 5, "min_score": 0.35}, "position": {"x": 740, "y": 60}},
    {"id": "n12", "type": "conversation_buffer", "label": "Conversation Buffer",
     "config": {"window": 12, "token_cap": 2000}, "position": {"x": 715, "y": 145}},
    {"id": "n6", "type": "context_assembler", "label": "Context Assembler",
     "config": {"system": "You are a careful, governed email assistant. Answer only from the provided context."},
     "position": {"x": 920, "y": 60}},
    {"id": "n7", "type": "prompt_template", "label": "Prompt Template",
     "config": {"template": "answer_with_context"}, "position": {"x": 920, "y": 230}},
    {"id": "n8", "type": "llm", "label": "LLM",
     "config": {"temperature": 0.2, "max_tokens": 512}, "position": {"x": 740, "y": 230}},
    {"id": "n9", "type": "interceptor", "label": "Interceptor (post)",
     "config": {"chain": ["policy_check", "schema_validate", "audit_tap"]}, "position": {"x": 560, "y": 230}},
    {"id": "n10", "type": "output_parser", "label": "Output Parser",
     "config": {"format": "text"}, "position": {"x": 380, "y": 230}},
    {"id": "n11", "type": "output", "label": "Output", "config": {"schema": "answer"}, "position": {"x": 200, "y": 230}}
  ],
  "edges": [
    {"from": "n1", "to": "n2"},
    {"from": "n2", "to": "n3"},
    {"from": "n3", "to": "n4"},
    {"from": "n3", "to": "n6", "to_port": "question"},
    {"from": "n4", "to": "n5"},
    {"from": "n5", "to": "n6", "to_port": "documents"},
    {"from": "n12", "to": "n6", "to_port": "memory"},
    {"from": "n6", "to": "n7"},
    {"from": "n7", "to": "n8"},
    {"from": "n8", "to": "n9"},
    {"from": "n9", "to": "n10"},
    {"from": "n10", "to": "n11"}
  ],
  "params": {"context_budget_tokens": 8000, "max_loops": 5, "seed": 42, "provider": "sim:helpful-v1",
             "invariants": ["no-model-call-after-block"]},
  "metadata": {"category": "Governance", "tags": ["governed", "rag", "memory", "flagship"], "origin": "pattern"}
}
